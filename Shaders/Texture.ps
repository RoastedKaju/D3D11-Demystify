// Texture2D and SamplerState are both bound from the C++ side:
// shaderTexture <- PSSetShaderResources, SampleType <- PSSetSamplers.
Texture2D shaderTexture;
SamplerState SampleType;

struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
};

float4 TexturePixelShader(PixelInputType input) : SV_TARGET
{
    float4 textureColor;

    // Sample() reads the texture at this pixel's interpolated UV coordinate,
    // using SampleType's filtering/wrapping rules (linear filtering, wrap
    // addressing - see TextureShader::InitializeShader).
    textureColor = shaderTexture.Sample(SampleType, input.tex);

    return textureColor;
}

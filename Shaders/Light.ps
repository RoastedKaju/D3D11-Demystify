Texture2D shaderTexture;
SamplerState SampleType;

// (b0)
cbuffer LightBuffer
{
    float4 diffuseColor;
    float4 ambientColor;
    float4 lightDirection;
    float4 specularColor;
    float  specularPower;
    float3 padding;
};

struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
    float3 normal : NORMAL;
    float3 viewDirection : VIEWDIR;
};

float4 LightPixelShader(PixelInputType input) : SV_TARGET
{
    float4 textureColor = shaderTexture.Sample(SampleType, input.tex);

    float3 lightDir = normalize(-lightDirection.xyz);
    float3 normal   = normalize(input.normal);
    float3 viewDir  = normalize(input.viewDirection);

    float lightIntensity = saturate(dot(normal, lightDir));

    float4 color = ambientColor;

    if (lightIntensity > 0.0f)
    {
        color += diffuseColor * lightIntensity;

        // Correct reflection vector
        float3 reflection = normalize(2 * dot(normal, lightDir) * normal - lightDir);

        // Specular term
        float spec = pow(saturate(dot(reflection, viewDir)), specularPower);
        color += specularColor * spec;
    }

    // Apply texture and clamp final result
    color *= textureColor;
    return saturate(color);
}

